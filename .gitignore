# =============================================
# BidSphere Landing Page - .gitignore
# =============================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
out/

# Environment variables & secrets (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env

# API keys and credentials
*.key
*.pem
secrets/
credentials/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Vite cache
.vite/

# Testing
coverage/
.nyc_output

# Misc
*.local

